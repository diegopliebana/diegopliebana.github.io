---
layout: default
---

{% if page.toc %}
  <div class="page-with-toc">

    <article class="page-main-content">
      {{ content }}

      {% if page.related_publications %}
        <h2>References</h2>
        <div class="publications">
          {% bibliography --cited_in_order %}
        </div>
      {% endif %}

      {% if site.giscus and page.giscus_comments %}
        {% include giscus.liquid %}
      {% endif %}
    </article>

    <aside class="page-toc-column">
      {% include project_toc.liquid %}
    </aside>

  </div>

{% else %}

  <article class="page-main-content">
    {{ content }}

    {% if page.related_publications %}
      <h2>References</h2>
      <div class="publications">
        {% bibliography --cited_in_order %}
      </div>
    {% endif %}

    {% if site.giscus and page.giscus_comments %}
      {% include giscus.liquid %}
    {% endif %}
  </article>

{% endif %}
